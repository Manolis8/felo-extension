{
  "manifest_version": 3,
  "name": "Unclawned",
  "version": "0.1.8",
  "description": "AI agent that controls your real Chrome browser. Automate any task on any website.",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["debugger", "tabs", "activeTab", "storage", "alarms", "webNavigation"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Unclawned",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": [
        "extension/recording-session.js",
        "extension/content-script.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": [
        "extension/bridge.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
